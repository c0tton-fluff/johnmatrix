:root{--bg:#0a0a0b;--surface:#111113;--surface-2:#161619;--border:rgba(255, 255, 255, 0.08);--border-hover:rgba(255, 255, 255, 0.18);--text:#ededed;--text-muted:rgba(237, 237, 237, 0.62);--text-faint:rgba(237, 237, 237, 0.4);--accent:#9298f5;--accent-soft:rgba(146, 152, 245, 0.14);--accent-hover:#aab0ff;--header-font:JetBrains Mono, ui-monospace, SF Mono, Menlo, monospace;--body-font:IBM Plex Sans, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif;--code-font:JetBrains Mono, ui-monospace, SF Mono, Menlo, monospace;--radius:8px}*,*::before,*::after{box-sizing:border-box}html,body{margin:0;padding:0;overflow-x:hidden;max-width:100vw;scroll-behavior:smooth;background-color:#0a0a0b;color:#ededed;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;font-feature-settings:"ss01","cv01"}::selection{background:rgba(146,152,245,.14);color:#aab0ff}img,picture,svg,video{max-width:100%;height:auto;display:block}a{color:#ededed;text-decoration:none;transition:color 150ms cubic-bezier(.22,.61,.36,1)}a:hover{color:#aab0ff}:focus-visible{outline:2px solid #9298f5;outline-offset:2px;border-radius:2px}.page{max-width:100%;padding:0}.center{max-width:760px;margin:0 auto;padding:6rem 1.5rem 5rem;box-sizing:border-box;width:100%;min-height:70vh}h1,h2,h3,h4,h5,h6{font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;margin:0;font-weight:600;letter-spacing:-.01em;color:#ededed}h1{font-size:2.25rem;font-weight:650;letter-spacing:-.025em;line-height:1.15;margin-bottom:.75rem}h2{font-size:1.35rem;font-weight:600;letter-spacing:-.015em;margin-top:3.5rem;margin-bottom:1rem}h3{font-size:1.05rem;font-weight:600;margin-top:2rem;margin-bottom:.5rem;color:#ededed}p{line-height:1.7;color:rgba(237,237,237,.62);margin:0 0 1.1rem}li{font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;color:rgba(237,237,237,.62)}strong,b{color:#ededed;font-weight:600}.eyebrow{font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:.7rem;font-weight:500;text-transform:uppercase;letter-spacing:.12em;color:rgba(237,237,237,.4);margin-bottom:.5rem;display:block}.article-title{font-size:2.25rem;font-weight:650;letter-spacing:-.025em;line-height:1.15;margin-bottom:.5rem}.article-meta{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:.72rem;color:rgba(237,237,237,.4);margin-bottom:2.5rem;padding-bottom:1.5rem;border-bottom:1px solid rgba(255,255,255,8%)}.article-meta .meta-sep{opacity:.5}.article-meta .meta-tag{color:#9298f5}.article-title+p,.content>p:first-of-type{color:rgba(237,237,237,.62);font-size:1.05rem;line-height:1.7;margin-bottom:2rem}body[data-slug=index] .article-title{display:none}body[data-slug=index] .article-meta{display:none}body[data-slug=index] .content{text-align:center}body[data-slug=index] .content table{text-align:left}.content a,.article-meta a{color:#ededed;text-decoration:none;background-image:linear-gradient(#9298f5,#9298f5);background-size:0% 1px;background-position:0 100%;background-repeat:no-repeat;transition:background-size 250ms cubic-bezier(.16,1,.3,1),color 150ms cubic-bezier(.22,.61,.36,1)}.content a:hover,.article-meta a:hover{color:#aab0ff;background-size:100% 1px}pre{background-color:#111113;border:1px solid rgba(255,255,255,8%);border-radius:8px;padding:1.1rem 1.25rem;font-size:.84rem;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;box-shadow:none;overflow-x:auto;overflow-y:hidden;margin:1.5rem 0}:not(pre)>code{font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;background:rgba(146,152,245,8%);border:1px solid rgba(146,152,245,.18);color:#9298f5;padding:.12rem .38rem;border-radius:4px;font-size:.85em}pre code{background:0 0;border:none;padding:0;color:#ededed;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace}.clipboard-button{position:absolute;top:.5rem;right:.5rem;background:#161619;border:1px solid rgba(255,255,255,8%);border-radius:6px;color:rgba(237,237,237,.4);padding:.3rem .55rem;font-size:.68rem;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;cursor:pointer;opacity:0;transition:opacity 150ms cubic-bezier(.22,.61,.36,1),color 150ms cubic-bezier(.22,.61,.36,1),border-color 150ms cubic-bezier(.22,.61,.36,1)}pre{position:relative}pre:hover .clipboard-button{opacity:1}.clipboard-button:hover{color:#ededed;border-color:rgba(255,255,255,.18)}.clipboard-button.copied{color:#4ade80;border-color:rgba(74,222,128,.3);opacity:1}blockquote{margin:1.75rem 0;padding:.25rem 0 .25rem 1.25rem;border-left:2px solid #9298f5;background:0 0;color:rgba(237,237,237,.62)}blockquote p{color:rgba(237,237,237,.62)}ul,ol{padding-left:1.25rem}li{margin:.4rem 0;line-height:1.65}li::marker{color:rgba(237,237,237,.4)}hr{border:none;margin:3.5rem 0;background:0 0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,8%),transparent)}.content table{width:100%;border-collapse:collapse;margin:2rem 0;font-size:.9rem}.content table th{font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:rgba(237,237,237,.4);text-align:left;padding:.75rem 1rem;border-bottom:1px solid rgba(255,255,255,.14);font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace}.content table td{padding:.75rem 1rem;border-bottom:1px solid rgba(255,255,255,8%);vertical-align:top;color:rgba(237,237,237,.62)}.content table tbody tr:last-child td{border-bottom:none}.content table tbody tr{transition:background 120ms cubic-bezier(.22,.61,.36,1)}.content table tbody tr:hover{background:rgba(255,255,255,2%)}.content img{border:1px solid rgba(255,255,255,8%);border-radius:8px;margin:1.75rem 0;display:block;max-width:100%}.breadcrumb-container{margin-bottom:1.5rem}.breadcrumb-element{font-size:.72rem;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;color:rgba(237,237,237,.4);background:0 0;border:none;padding:0;text-transform:none;letter-spacing:.02em}.breadcrumb-element a{color:rgba(237,237,237,.4);text-decoration:none;background:0 0}.breadcrumb-element a:hover{color:rgba(237,237,237,.62)}.breadcrumb-sep{color:rgba(237,237,237,.4);margin:0 .5rem;opacity:.5;font-size:.72rem}.tags{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0 1.5rem}.tag-link{font-size:.7rem;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;color:rgba(237,237,237,.62);text-decoration:none;padding:.2rem .6rem;border:1px solid rgba(255,255,255,8%);border-radius:100px;background:#111113;transition:all 150ms cubic-bezier(.22,.61,.36,1)}.tag-link:hover{border-color:#9298f5;color:#9298f5;background:rgba(146,152,245,8%)}.top-nav{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 2rem;background:rgba(10,10,11,.6);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid transparent;position:sticky;top:0;z-index:1000;width:100%;box-sizing:border-box;transition:border-color 200ms cubic-bezier(.22,.61,.36,1),background 200ms cubic-bezier(.22,.61,.36,1)}.top-nav.scrolled{border-bottom-color:rgba(255,255,255,8%);background:rgba(10,10,11,.85)}.top-nav-links{display:flex;gap:2rem;align-items:center}.top-nav-link{color:rgba(237,237,237,.62);text-decoration:none;font-size:.82rem;font-weight:500;letter-spacing:-.005em;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;padding:.4rem 0;position:relative;transition:color 150ms cubic-bezier(.22,.61,.36,1);background:0 0}.top-nav-link::after{content:"";position:absolute;bottom:0;left:0;width:0;height:1.5px;background:#9298f5;border-radius:2px;transition:width 200ms cubic-bezier(.16,1,.3,1)}.top-nav-link:hover{color:#ededed}.top-nav-link:hover::after{width:100%}.top-nav-link.active{color:#ededed}.top-nav-link.active::after{width:100%}.top-nav-right{display:flex;align-items:center;gap:.5rem}.top-nav-search{background:#111113;border:1px solid rgba(255,255,255,8%);border-radius:6px;color:rgba(237,237,237,.4);cursor:pointer;padding:.45rem .7rem;transition:all 150ms cubic-bezier(.22,.61,.36,1);display:flex;align-items:center;gap:.5rem;min-height:36px;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:.72rem}.top-nav-search:hover{color:#ededed;border-color:rgba(255,255,255,.18);background:#161619}.top-nav-search .search-kbd{font-size:.62rem;padding:.1rem .35rem;border:1px solid rgba(255,255,255,8%);border-radius:4px;color:rgba(237,237,237,.4);background:#0a0a0b}.top-nav-hamburger{display:none;background:#111113;border:1px solid rgba(255,255,255,8%);border-radius:6px;cursor:pointer;padding:.55rem;flex-direction:column;gap:4px;width:38px;height:38px;align-items:center;justify-content:center}.hamburger-line{display:block;width:16px;height:1.5px;background:rgba(237,237,237,.62);transition:transform .2s cubic-bezier(.22,.61,.36,1),opacity .2s cubic-bezier(.22,.61,.36,1)}.top-nav-hamburger.open .hamburger-line:nth-child(1){transform:translateY(5.5px)rotate(45deg)}.top-nav-hamburger.open .hamburger-line:nth-child(2){opacity:0}.top-nav-hamburger.open .hamburger-line:nth-child(3){transform:translateY(-5.5px)rotate(-45deg)}.mobile-menu{position:absolute;top:100%;left:0;right:0;background:rgba(10,10,11,.96);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,8%);padding:.5rem 1.5rem 1rem;flex-direction:column;opacity:0;transform:translateY(-8px);transition:opacity .2s cubic-bezier(.22,.61,.36,1),transform .2s cubic-bezier(.22,.61,.36,1);display:none}.mobile-menu.open{display:flex;opacity:1;transform:translateY(0)}.mobile-menu-link{color:rgba(237,237,237,.62);text-decoration:none;font-size:.9rem;font-weight:500;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;padding:.9rem 0;min-height:48px;display:flex;align-items:center;border-bottom:1px solid rgba(255,255,255,8%);transition:color 150ms cubic-bezier(.22,.61,.36,1);background:0 0}.mobile-menu-link:last-child{border-bottom:none}.mobile-menu-link:hover{color:#ededed}.mobile-menu-link.active{color:#9298f5}@media(max-width:768px){.top-nav{padding:.85rem 1rem}.top-nav-links{display:none}.top-nav-hamburger{display:flex}.top-nav-search .search-kbd{display:none}}.reading-progress{position:fixed;top:0;left:0;width:0%;height:2px;background:linear-gradient(90deg,#9298f5,#aab0ff);z-index:1001;transition:width 60ms linear;pointer-events:none}.back-to-top{position:fixed;bottom:1.5rem;right:1.5rem;width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:#111113;border:1px solid rgba(255,255,255,8%);border-radius:6px;color:rgba(237,237,237,.4);cursor:pointer;opacity:0;visibility:hidden;transition:all 200ms cubic-bezier(.22,.61,.36,1);z-index:999;backdrop-filter:blur(8px)}.back-to-top.visible{opacity:1;visibility:visible}.back-to-top:hover{border-color:rgba(255,255,255,.18);color:#ededed;background:#161619;transform:translateY(-2px)}@media(max-width:768px){.back-to-top{bottom:1rem;right:1rem}}.hero-intro{margin:0 auto;max-width:640px;padding:3rem 0 2.5rem}.hero-tagline{font-size:1.1rem;color:rgba(237,237,237,.62);line-height:1.65;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;font-weight:400;letter-spacing:-.01em}.terminal-line{font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:1.35rem;color:#ededed;margin-bottom:1.25rem;min-height:2.5rem;display:flex;align-items:center;justify-content:center;gap:.5rem}.terminal-prompt{color:#9298f5;user-select:none}.terminal-text{color:#ededed}.terminal-cursor{display:inline-block;width:.6rem;height:1.35rem;background:#9298f5;animation:termBlink .9s step-end infinite;vertical-align:middle;border-radius:1px}@keyframes termBlink{0%,100%{opacity:1}50%{opacity:0}}.progress-section{margin:2.5rem auto;max-width:520px;text-align:left}.progress-item{margin-bottom:1.5rem}.progress-label{display:flex;justify-content:space-between;font-size:.78rem;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;color:rgba(237,237,237,.62);font-weight:500;margin-bottom:.5rem}.progress-bar{height:6px;background:#111113;border:1px solid rgba(255,255,255,8%);border-radius:100px;position:relative;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#9298f5,#aab0ff);width:0;border-radius:100px;transition:width 1.2s cubic-bezier(.16,1,.3,1)}.featured-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin:2rem 0;text-align:left}.featured-card{display:flex;flex-direction:column;padding:1.5rem 1.5rem 1.35rem;border:1px solid rgba(255,255,255,8%);border-radius:8px;text-decoration:none;transition:transform 200ms cubic-bezier(.22,.61,.36,1),border-color 200ms cubic-bezier(.22,.61,.36,1),background 200ms cubic-bezier(.22,.61,.36,1);background:#111113}.featured-card:hover{border-color:rgba(255,255,255,.18);background:#161619;transform:translateY(-2px)}.featured-icon{font-size:1.1rem;opacity:.5;margin-bottom:.85rem;transition:opacity 200ms cubic-bezier(.22,.61,.36,1),color 200ms cubic-bezier(.22,.61,.36,1)}.featured-card:hover .featured-icon{opacity:1;color:#9298f5}.featured-body{flex:1;display:flex;flex-direction:column}.featured-title{display:block;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;font-size:.95rem;font-weight:600;color:#ededed;letter-spacing:-.01em;margin-bottom:.4rem}.featured-desc{display:block;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;font-size:.82rem;color:rgba(237,237,237,.62);line-height:1.55}.featured-arrow{color:rgba(237,237,237,.4);font-size:.85rem;margin-top:.85rem;align-self:flex-end;transition:transform 200ms cubic-bezier(.22,.61,.36,1),color 200ms cubic-bezier(.22,.61,.36,1);opacity:0}.featured-card:hover .featured-arrow{opacity:1;color:#9298f5;transform:translateX(3px)}@media(max-width:600px){.featured-grid{grid-template-columns:1fr}}.cert-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.75rem;margin:1.5rem 0}.cert-card{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1.4rem 1rem;min-height:110px;border:1px solid rgba(255,255,255,8%);border-radius:8px;text-decoration:none;text-align:center;transition:transform 200ms cubic-bezier(.22,.61,.36,1),border-color 200ms cubic-bezier(.22,.61,.36,1),background 200ms cubic-bezier(.22,.61,.36,1);background:#111113}.cert-card:hover{border-color:rgba(255,255,255,.18);background:#161619;transform:translateY(-2px)}.cert-code{display:block;font-size:.95rem;font-weight:600;color:#ededed;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;letter-spacing:.01em;margin-bottom:.6rem;padding-bottom:.5rem;border-bottom:1px solid rgba(255,255,255,8%);width:100%}.cert-desc{display:block;font-size:.72rem;color:rgba(237,237,237,.4);line-height:1.45;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif}.cert-card-wide{grid-column:span 2}@media(max-width:600px){.cert-grid{grid-template-columns:repeat(2,1fr)}.cert-card-wide{grid-column:span 2}}@media(max-width:400px){.cert-grid{grid-template-columns:1fr}.cert-card-wide{grid-column:span 1}}.stats-header{display:flex;gap:0;margin:2rem auto;border:1px solid rgba(255,255,255,8%);border-radius:8px;background:#111113;width:fit-content;max-width:100%;overflow:hidden}.stat-item{padding:1.1rem 1.6rem;text-align:center;border-right:1px solid rgba(255,255,255,8%)}.stat-item:last-child{border-right:none}.stat-value{font-size:1.6rem;font-weight:650;color:#ededed;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;letter-spacing:-.02em}.stat-label{font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;color:rgba(237,237,237,.4);margin-top:.3rem;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif}@media(max-width:768px){.stats-header{flex-wrap:wrap}.stat-item{flex:1 1 50%;border-bottom:1px solid rgba(255,255,255,8%)}.stat-item:nth-child(2){border-right:none}}@media(max-width:480px){.stat-item{flex:1 1 100%;border-right:none}}.folder-hero{text-align:center;margin:1rem 0 2rem}.folder-hero img{margin:0 auto;max-height:96px;width:auto;border:none;border-radius:0}body:has(.folder-hero) .article-title{display:none}body:has(.folder-hero) .breadcrumb-container{display:none}.section-title{font-size:1.1rem;font-weight:600;letter-spacing:-.01em;margin-top:2.5rem;margin-bottom:1rem;color:#ededed;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;border:none;padding:0}ul.section-ul{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:.6rem;list-style:none;padding:0;margin:0 0 2rem;width:100%}ul.section-ul>li.section-li{margin:0;padding:0}ul.section-ul>li.section-li a{display:flex;align-items:center;justify-content:space-between;padding:.85rem 1rem;text-decoration:none;color:#ededed;background:#111113;border:1px solid rgba(255,255,255,8%);border-radius:6px;font-size:.85rem;font-weight:500;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;letter-spacing:-.005em;transition:all 180ms cubic-bezier(.22,.61,.36,1);line-height:1.3}ul.section-ul>li.section-li a::after{content:"\2192";color:rgba(237,237,237,.4);font-size:.8rem;opacity:0;transition:opacity 180ms cubic-bezier(.22,.61,.36,1),transform 180ms cubic-bezier(.22,.61,.36,1),color 180ms cubic-bezier(.22,.61,.36,1);flex-shrink:0;margin-left:.75rem}ul.section-ul>li.section-li a:hover{background:#161619;border-color:rgba(255,255,255,.18);transform:translateX(2px)}ul.section-ul>li.section-li a:hover::after{opacity:1;transform:translateX(2px);color:#9298f5}.section-li.tag-hidden{display:none!important}@media(max-width:768px){ul.section-ul{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}}.tag-filter{display:flex;flex-wrap:wrap;gap:.4rem;margin:1.5rem 0 .5rem;justify-content:flex-start}.tag-filter-btn{background:#111113;border:1px solid rgba(255,255,255,8%);border-radius:100px;color:rgba(237,237,237,.62);padding:.35rem .8rem;font-size:.7rem;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;letter-spacing:.02em;cursor:pointer;transition:all 150ms cubic-bezier(.22,.61,.36,1)}.tag-filter-btn:hover{border-color:rgba(255,255,255,.18);color:#ededed}.tag-filter-btn.active{border-color:#9298f5;color:#9298f5;background:rgba(146,152,245,8%)}.machine-card{display:flex;flex-wrap:wrap;gap:0;margin:1.25rem 0 1.5rem;border:1px solid rgba(255,255,255,8%);border-radius:8px;background:#111113;width:fit-content;overflow:hidden}.machine-card-item{display:flex;flex-direction:column;padding:.7rem 1.2rem;border-right:1px solid rgba(255,255,255,8%)}.machine-card-item:last-child{border-right:none}.machine-card-label{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;color:rgba(237,237,237,.4);margin-bottom:.3rem;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif}.machine-card-value{font-size:.82rem;font-weight:500;color:#ededed;text-transform:capitalize;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace}.machine-card-value.difficulty{font-weight:600}.machine-card-value.vuln{color:#9298f5;text-transform:uppercase;font-size:.72rem;letter-spacing:.04em}@media(max-width:600px){.machine-card{flex-direction:column;width:100%}.machine-card-item{border-right:none;border-bottom:1px solid rgba(255,255,255,8%);flex-direction:row;justify-content:space-between;align-items:center}.machine-card-item:last-child{border-bottom:none}.machine-card-label{margin-bottom:0}}.toc{display:none;position:fixed;right:2rem;top:6.5rem;width:200px;font-size:.75rem;border-left:1px solid rgba(255,255,255,8%);padding-left:1rem;background:0 0}.toc ul{list-style:none;padding:0;margin:0}.toc li{margin:.5rem 0}.toc a{color:rgba(237,237,237,.4);text-decoration:none;transition:color 150ms cubic-bezier(.22,.61,.36,1);font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif}.toc a:hover,.toc a.active{color:#9298f5}@media(min-width:1280px){.toc{display:block}}#search-container{position:fixed;inset:0;background:rgba(5,5,6,.75);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:2000;display:none;align-items:flex-start;justify-content:center;padding-top:15vh}#search-container.active{display:flex}#search-shell{width:90vw;max-width:600px;position:relative;background:#111113;border:1px solid rgba(255,255,255,.14);border-radius:8px;box-shadow:0 24px 64px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,4%);overflow:hidden}#search-input{width:100%;background:0 0;border:none;border-bottom:1px solid rgba(255,255,255,8%);color:#ededed;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:.95rem;padding:1.1rem 1.25rem;outline:none;box-sizing:border-box}#search-input::placeholder{color:rgba(237,237,237,.4)}#search-results{max-height:50vh;overflow-y:auto;padding:.5rem}#search-results .search-result{display:block;padding:.7rem .9rem;border-radius:6px;text-decoration:none;color:rgba(237,237,237,.62);margin-bottom:.15rem;transition:background 120ms cubic-bezier(.22,.61,.36,1)}#search-results .search-result:hover,#search-results .search-result.active{background:#161619}#search-results .search-result .search-result-title{font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;font-size:.85rem;color:#ededed;font-weight:500}#search-results .search-result .search-result-url{font-size:.68rem;color:rgba(237,237,237,.4);margin-top:.2rem;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace}#search-close{position:absolute;top:.9rem;right:1rem;background:0 0;border:none;color:rgba(237,237,237,.4);font-size:1.4rem;cursor:pointer;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:6px}#search-close:hover{color:#ededed;background:#161619}.terminal-404{font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;max-width:480px;margin:3rem auto;text-align:left}.terminal-404-window{border:1px solid rgba(255,255,255,8%);border-radius:8px;background:#111113;overflow:hidden}.terminal-404-bar{padding:.6rem 1rem;border-bottom:1px solid rgba(255,255,255,8%);font-size:.68rem;color:rgba(237,237,237,.4);display:flex;align-items:center;gap:.5rem}.terminal-404-dot{width:8px;height:8px;border-radius:50%;display:inline-block}.terminal-404-body{padding:1.5rem;font-size:.82rem;line-height:1.85}.t404-prompt{color:#9298f5}.t404-cmd{color:#ededed}.t404-err{color:#f87171}.t404-dim{color:rgba(237,237,237,.4)}.t404-link{display:inline-block;margin-top:1rem;color:#9298f5;text-decoration:none;border:1px solid #9298f5;border-radius:6px;padding:.45rem .9rem;font-size:.78rem;transition:background 150ms cubic-bezier(.22,.61,.36,1)}.t404-link:hover{background:rgba(146,152,245,8%)}footer{max-width:760px;margin:0 auto;padding:2.5rem 1.5rem;border-top:1px solid rgba(255,255,255,8%);font-size:.75rem;color:rgba(237,237,237,.4);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem}footer a{color:rgba(237,237,237,.4);text-decoration:none;transition:color 150ms cubic-bezier(.22,.61,.36,1)}footer a:hover{color:#ededed}.footer-links{display:flex;gap:1.5rem}.footer-meta{display:flex;gap:.75rem;opacity:.8;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace}.reveal{opacity:0;transform:translateY(10px);transition:opacity .5s cubic-bezier(.16,1,.3,1),transform .5s cubic-bezier(.16,1,.3,1)}.reveal.visible{opacity:1;transform:translateY(0)}.section-li.reveal:nth-child(1),.cert-card.reveal:nth-child(1),.featured-card.reveal:nth-child(1){transition-delay:0ms}.section-li.reveal:nth-child(2),.cert-card.reveal:nth-child(2),.featured-card.reveal:nth-child(2){transition-delay:45ms}.section-li.reveal:nth-child(3),.cert-card.reveal:nth-child(3),.featured-card.reveal:nth-child(3){transition-delay:90ms}.section-li.reveal:nth-child(4),.cert-card.reveal:nth-child(4),.featured-card.reveal:nth-child(4){transition-delay:135ms}.section-li.reveal:nth-child(5),.cert-card.reveal:nth-child(5),.featured-card.reveal:nth-child(5){transition-delay:180ms}.section-li.reveal:nth-child(6),.cert-card.reveal:nth-child(6),.featured-card.reveal:nth-child(6){transition-delay:225ms}.section-li.reveal:nth-child(7),.cert-card.reveal:nth-child(7),.featured-card.reveal:nth-child(7){transition-delay:270ms}.section-li.reveal:nth-child(8),.cert-card.reveal:nth-child(8),.featured-card.reveal:nth-child(8){transition-delay:315ms}.section-li.reveal:nth-child(9),.cert-card.reveal:nth-child(9),.featured-card.reveal:nth-child(9){transition-delay:360ms}.section-li.reveal:nth-child(10),.cert-card.reveal:nth-child(10),.featured-card.reveal:nth-child(10){transition-delay:405ms}.section-li.reveal:nth-child(11),.cert-card.reveal:nth-child(11),.featured-card.reveal:nth-child(11){transition-delay:450ms}.section-li.reveal:nth-child(12),.cert-card.reveal:nth-child(12),.featured-card.reveal:nth-child(12){transition-delay:495ms}@supports(view-transition-name:root){::view-transition-old(root){animation:vt-out 180ms cubic-bezier(.22,.61,.36,1)forwards}::view-transition-new(root){animation:vt-in 280ms cubic-bezier(.16,1,.3,1)120ms forwards}@keyframes vt-out{to{opacity:0;transform:translateY(-6px)}}@keyframes vt-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}}@media(prefers-reduced-motion:reduce){::view-transition-old(root),::view-transition-new(root){animation:none!important}.reveal{opacity:1!important;transform:none!important;transition:none!important}.terminal-cursor,.reading-progress{animation:none!important}.progress-fill{transition:none!important}html,body{scroll-behavior:auto}}@media(max-width:768px){.center{padding:4.5rem 1.1rem 3rem}h1,.article-title{font-size:1.75rem}h2{font-size:1.15rem}.terminal-line{font-size:1.05rem}footer{padding:2rem 1.1rem}}