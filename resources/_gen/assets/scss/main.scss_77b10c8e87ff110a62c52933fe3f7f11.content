r{color:rgba(232,230,227,.72)}#search-results{margin-top:.5rem;max-height:50vh;overflow-y:auto}#search-results .search-result{display:block;padding:.75rem 1rem;border:1px dashed rgba(255,255,255,.15);border-left:2px solid transparent;text-decoration:none;color:#e8e6e3;margin-bottom:.4rem;transition:all 150ms ease}#search-results .search-result:hover{border-left-color:#cda54b;background:rgba(205,165,75,5%)}#search-results .search-result .search-result-title{font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:.85rem;color:#fff}#search-results .search-result .search-result-url{font-size:.7rem;color:rgba(232,230,227,.72);margin-top:.2rem}#search-close{position:absolute;top:-2.5rem;right:0;background:0 0;border:1px dashed rgba(255,255,255,.15);color:rgba(232,230,227,.72);font-size:1.2rem;width:32px;height:32px;cursor:pointer}#search-close:hover{color:#fff;border-color:rgba(255,255,255,.4)}.terminal-404{font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;max-width:500px;margin:4rem auto;text-align:left}.terminal-404-window{border:1px dashed rgba(255,255,255,.15);background:#1a1a1a}.terminal-404-bar{padding:.5rem 1rem;border-bottom:1px dashed rgba(255,255,255,.15);font-size:.7rem;color:rgba(232,230,227,.72);display:flex;align-items:center;gap:.5rem}.terminal-404-dot{width:8px;height:8px;border-radius:50%;display:inline-block}.terminal-404-body{padding:1.5rem;font-size:.85rem;line-height:1.8}.t404-prompt{color:#cda54b}.t404-cmd{color:#fff}.t404-err{color:#e74c3c}.t404-dim{color:rgba(232,230,227,.72)}.t404-link{display:inline-block;margin-top:1rem;color:#cda54b;text-decoration:none;border:1px dashed #cda54b;padding:.5rem 1rem;font-size:.8rem;transition:background 150ms ease}.t404-link:hover{background:rgba(205,165,75,.1)}.reveal{opacity:0;transform:translateY(12px);transition:opacity .4s ease-out,transform .4s ease-out}.reveal.visible{opacity:1;transform:translateY(0)}pre.reveal{opacity:0;transform:translateX(-10px);transition:opacity .4s ea