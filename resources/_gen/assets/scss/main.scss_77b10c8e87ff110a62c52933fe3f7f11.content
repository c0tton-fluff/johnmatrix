coration:none;font-size:.85rem;font-weight:500;letter-spacing:.05em;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;padding:0 0 4px;position:relative;transition:color 150ms ease;background:0 0}.top-nav-link::after{content:"";position:absolute;bottom:0;left:0;width:0;height:1px;border-bottom:1px dashed rgba(255,255,255,.3);transition:width .3s ease}.top-nav-link:hover{color:#fff}.top-nav-link:hover::after{width:100%}.top-nav-link.active{color:#fff}.top-nav-link.active::after{width:100%;border-bottom-color:rgba(255,255,255,.5)}.top-nav-right{display:flex;align-items:center;gap:1rem}.top-nav-search{background:0 0;border:none;color:#e8e6e3;cursor:pointer;padding:.5rem;transition:color 150ms ease;display:flex;min-width:48px;min-height:48px;align-items:center;justify-content:center}.top-nav-search:hover{color:#fff}.top-nav-hamburger{display:none;background:0 0;border:none;cursor:pointer;padding:.5rem;flex-direction:column;gap:4px;width:28px}.hamburger-line{display:block;width:100%;height:1.5px;background:#e8e6e3;transition:transform .2s ease,opacity .2s ease}.top-nav-hamburger.open .hamburger-line:nth-child(1){transform:translateY(5.5px)rotate(45deg)}.top-nav-hamburger.open .hamburger-line:nth-child(2){opacity:0}.top-nav-hamburger.open .hamburger-line:nth-child(3){transform:translateY(-5.5px)rotate(-45deg)}.mobile-menu{position:absolute;top:100%;left:0;right:0;background:rgba(13,13,13,.95);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px dashed rgba(255,255,255,.15);padding:1rem 2rem 1.5rem;flex-direction:column;gap:0;opacity:0;transform:translateY(-8px);transition:opacity .2s ease,transform .2s ease;display:none}.mobile-menu.open{display:flex;opacity:1;transform:translateY(0)}.mobile-menu-link{color:#e8e6e3;text-decoration:none;font-size:.9rem;font-weight:500;letter-spacing:.05em;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;padding:1rem 0;min-height:48px;display:flex;align-items:center;border-bottom:1px dashed rgba(255,255,255,8%);transition:color 150ms ease;background:0 0}.mobile-menu-link:last-child{border-bottom:none}.mobile-menu-link:hover{color:#fff}.mobile-menu-link.active{color:#cda54b}@media(max-width:768px){.top-nav{padding:.75rem 1rem}.top-nav-links{display:none}.top-nav-hamburger{display:flex}}.reading-progress{position:fixed;top:0;left:0;width:0%;height:2px;background:linear-gradient(90deg,#cda54b,#f4d03f);z-index:1001;transition:width 50ms ease-out;pointer-events:none}.back-to-top{position:fixed;bottom:2rem;right:2rem;width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:#0d0d0d;border:1px dashed rgba(255,255,255,.15);color:rgba(232,230,227,.72);cursor:pointer;opacity:0;visibility:hidden;transition:all 200ms ease;z-index:999}.back-to-top.visible{opacity:1;visibility:visible}.back-to-top:hover{border-color:rgba(255,255,255,.4);color:#fff;background:rgba(255,255,255,5%)}@media(max-width:768px){.back-to-top{bottom:1rem;right:1rem;width:36px;height:36px}}.hero-intro{margin:0 auto;max-width:600px;padding:4rem 0 2rem}.hero-tagline{font-size:1rem;color:rgba(232,230,227,.72);line-height:1.7;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;font-weight:400}.terminal-line{font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:1.5rem;color:#fff;margin-bottom:1rem;min-height:2.5rem;display:flex;align-items:center;justify-content:center;gap:.5rem}.terminal-prompt{color:#cda54b;user-select:none}.terminal-text{color:#fff}.terminal-cursor{display:inline-block;width:.6rem;height:1.5rem;background:#cda54b;animation:termBlink .8s step-end infinite;vertical-align:middle}@keyframes termBlink{0%,100%{opacity:1}50%{opacity:0}}.progress-section{margin:2rem auto;max-width:500px;text-align:left}.progress-item{margin-bottom:1.25rem}.progress-label{display:flex;justify-content:space-between;font-size:.75rem;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;color:rgba(232,230,227,.72);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem}.progress-bar{height:4px;background:#1a1a1a;border:1px dashed rgba(255,255,255,.15);position:relative;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#cda54b,#f4d03f);width:0;transition:width 1.2s cubic-bezier(.25,.46,.45,.94)}.featured-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem;margin:2rem 0;text-align:left}.featured-card{display:flex;flex-direction:column;gap:0;padding:1.25rem 1.5rem;border:1px dashed rgba(255,255,255,.15);border-left:2px solid transparent;text-decoration:none;transition:all 200ms ease;background:0 0}.featured-card:hover{border-left-color:#cda54b;background:rgba(205,165,75,4%)}.featured-icon{font-size:1.1rem;opacity:.4;margin-bottom:.75rem;transition:opacity 200ms ease}.featured-card:hover .featured-icon{opacity:.8}.featured-body{flex:1;display:flex;flex-direction:column}.featured-title{display:block;font-family:jetbrains mono,ui-monospace,sf mono,Menlo,monospace;font-size:.9rem;font-weight:600;color:#fff;letter-spacing:.05em;margin-bottom:.4rem}.featured-desc{display:block;font-family:ibm plex sans,-apple-system,BlinkMacSystemFont,segoe ui,sans-serif;font-size:.78rem;color:rgba(232,230,227,.72);line-height:1.6}.featured-arrow{color:rgba(232,230,227,.72);font-size:.8rem;margin-top:.75rem;align-self:flex-end;transition:transform 200ms ease,color 200ms ease;opacity:0}.featured-card:hover .featured-arrow{opacity:1;color:#cda54b;transform:translateX(4px)}@media(max-width:600px){.featured-grid{grid-template-columns:1fr}}.cert-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;margin:2rem 0;max-width:100%;box-sizing:border-box;overflow:hidden}.cert-card{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1.5rem 1rem;min-height:100px;border:1px dashed rgba(255,255,255,.15);text-decoration:none;text-align:center;transition:border-color 150ms ease,background 150ms ease;background